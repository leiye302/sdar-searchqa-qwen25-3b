SDAR_PYTHON=python
SDAR_GPUS=0,1,2,3
SDAR_CPUS=32
SEARCH_URL=http://127.0.0.1:8000/retrieve
RETRIEVER_PYTHON=python
# The native retriever may SHARE these allocated cards with training.
# Account for FAISS index and E5 memory; do not select other users' GPUs.
RETRIEVER_GPUS=0,1,2,3
# Optional short writable existing directory for Ray sockets.
# SDAR_RUNTIME_ROOT=/tmp
# Explicit shared QA/retrieval directories may be passed via CLI flags.
